{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @pwasdk/core build && pnpm --filter react-playground build",
  "outputDirectory": "apps/react-playground/dist",
  "rewrites": [
    {
      "source": "/((?!assets/|sw\\.js|manifest\\.json).*)",
      "destination": "/index.html"
    }
  ]
}
