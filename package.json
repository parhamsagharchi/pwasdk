{
  "name": "pwasdk",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for @pwasdk/core — Progressive Web App browser helpers",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm --filter @pwasdk/core build",
    "build:playground": "pnpm --filter @pwasdk/core build && pnpm --filter playground build",
    "build:all": "pnpm -r build"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  }
}
